<section class="panel notes-panel" aria-label="Notes">
    <header class="panel-header">
        <h2>Notes</h2>
        <span class="count">@Notes.Count</span>
        <span class="spacer"></span>
        <label class="sort-picker muted">
            Sort
            <select class="input small" title="Sort notes" value="@SortOrder" @onchange="OnSortChangedAsync">
                <option value="@NoteSortOrder.DateCreated">Date created (newest)</option>
                <option value="@NoteSortOrder.LastModified">Last modified (newest)</option>
                <option value="@NoteSortOrder.Type">Type</option>
            </select>
        </label>
        <span class="header-divider"></span>
        <button type="button" class="btn icon small" title="Collapse all notes" aria-label="Collapse all notes" disabled="@(Notes.Count == 0)" @onclick="CollapseAll">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 11l6-6 6 6" />
                <path d="M6 20l6-6 6 6" />
            </svg>
        </button>
        <button type="button" class="btn icon small" title="Expand all notes" aria-label="Expand all notes" disabled="@(Notes.Count == 0)" @onclick="ExpandAll">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 4l6 6 6-6" />
                <path d="M6 13l6 6 6-6" />
            </svg>
        </button>
        <span class="header-divider"></span>
        <button type="button" class="btn small primary" @onclick="() => OnNew.InvokeAsync(NoteType.Text)">New Note</button>
        <button type="button" class="btn small" @onclick="() => OnNew.InvokeAsync(NoteType.Sql)">New SQL</button>
        <button type="button" class="btn small" @onclick="() => OnNew.InvokeAsync(NoteType.Diagram)">New Diagram</button>
    </header>
    <div class="panel-body">
        @if (Notes.Count == 0)
        {
            <p class="muted empty">No notes yet. Add one with New Note, New SQL or New Diagram.</p>
        }

        @foreach (var group in GetGroups())
        {
            <h3 class="day-heading" @key="group.Heading">@group.Heading</h3>
            @foreach (var note in group.Notes)
            {
                <NoteCard @key="note.FilePath"
                          Note="note"
                          ShowModified="@(SortOrder == NoteSortOrder.LastModified)"
                          IsCollapsed="_collapsedNotes.Contains(note.FilePath)"
                          OnToggleCollapse="ToggleCollapse"
                          OnEdit="OnEdit"
                          OnDelete="OnDelete" />
            }
        }
    </div>
</section>

@code {
    // Keyed by file path so a note stays collapsed when the list reloads; notes added later start expanded.
    private readonly HashSet<string> _collapsedNotes = new(StringComparer.OrdinalIgnoreCase);

    [Parameter, EditorRequired]
    public IReadOnlyList<JournalNote> Notes { get; set; } = [];

    [Parameter]
    public NoteSortOrder SortOrder { get; set; }

    [Parameter]
    public EventCallback<NoteSortOrder> OnSortChanged { get; set; }

    [Parameter]
    public EventCallback<NoteType> OnNew { get; set; }

    [Parameter]
    public EventCallback<JournalNote> OnEdit { get; set; }

    [Parameter]
    public EventCallback<JournalNote> OnDelete { get; set; }

    private sealed record NoteGroup(string Heading, IReadOnlyList<JournalNote> Notes);

    private IEnumerable<NoteGroup> GetGroups()
    {
        var sorted = NoteSorter.Sort(Notes, SortOrder);

        return SortOrder switch
        {
            NoteSortOrder.Type => sorted
                .GroupBy(note => note.Type)
                .Select(group => new NoteGroup(GetTypeHeading(group.Key), group.ToList())),
            NoteSortOrder.LastModified => sorted
                .GroupBy(note => note.ModifiedOn.Date)
                .Select(group => new NoteGroup(FormatDay(group.Key), group.ToList())),
            _ => sorted
                .GroupBy(note => note.CreatedOn.Date)
                .Select(group => new NoteGroup(FormatDay(group.Key), group.ToList()))
        };
    }

    private static string GetTypeHeading(NoteType type) => type switch
    {
        NoteType.Sql => "SQL notes",
        NoteType.Diagram => "Diagram notes",
        _ => "Text notes"
    };

    private Task OnSortChangedAsync(ChangeEventArgs e)
    {
        return Enum.TryParse<NoteSortOrder>(e.Value?.ToString(), out var order)
            ? OnSortChanged.InvokeAsync(order)
            : Task.CompletedTask;
    }

    private void CollapseAll()
    {
        _collapsedNotes.UnionWith(Notes.Select(note => note.FilePath));
    }

    private void ExpandAll()
    {
        _collapsedNotes.Clear();
    }

    private void ToggleCollapse(JournalNote note)
    {
        if (!_collapsedNotes.Remove(note.FilePath))
        {
            _collapsedNotes.Add(note.FilePath);
        }
    }

    private static string FormatDay(DateTime date)
    {
        var today = DateTime.Today;
        var formatted = date.ToString("dddd, MMMM d, yyyy");

        if (date == today)
        {
            return $"Today - {formatted}";
        }

        return date == today.AddDays(-1) ? $"Yesterday - {formatted}" : formatted;
    }
}
