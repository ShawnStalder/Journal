@inject IJSRuntime Js
@inject ILinkService Links

<div class="rte">
    <div class="rte-toolbar" role="toolbar" aria-label="Formatting">
        <select class="input small" title="Paragraph style" @onchange="OnBlockChangedAsync">
            <option value="p">Paragraph</option>
            <option value="h1">Heading 1</option>
            <option value="h2">Heading 2</option>
            <option value="h3">Heading 3</option>
            <option value="blockquote">Quote</option>
        </select>

        <span class="rte-group">
            <button type="button" class="btn icon small" title="Bold (Ctrl+B)" @onmousedown:preventDefault @onclick='() => ExecuteAsync("bold")'><b>B</b></button>
            <button type="button" class="btn icon small" title="Italic (Ctrl+I)" @onmousedown:preventDefault @onclick='() => ExecuteAsync("italic")'><i>I</i></button>
            <button type="button" class="btn icon small" title="Underline (Ctrl+U)" @onmousedown:preventDefault @onclick='() => ExecuteAsync("underline")'><u>U</u></button>
            <button type="button" class="btn icon small" title="Strikethrough" @onmousedown:preventDefault @onclick='() => ExecuteAsync("strikeThrough")'><s>S</s></button>
        </span>

        <span class="rte-group" title="Text color">
            <span class="rte-label">A</span>
            @foreach (var color in TextColors)
            {
                <button type="button" class="swatch" style="background:@color" title="Text color @color" aria-label="Text color @color" @onmousedown:preventDefault @onclick='() => ExecuteAsync("foreColor", color)'></button>
            }
            <input type="color" class="color-input" title="Custom text color" value="#ff8800" @onchange='e => ExecuteAsync("foreColor", e.Value)' />
        </span>

        <span class="rte-group" title="Highlight">
            <span class="rte-label rte-highlight">ab</span>
            @foreach (var color in HighlightColors)
            {
                <button type="button" class="swatch" style="background:@color" title="Highlight @color" aria-label="Highlight @color" @onmousedown:preventDefault @onclick='() => ExecuteAsync("hiliteColor", color)'></button>
            }
            <button type="button" class="btn icon small" title="Remove highlight" @onmousedown:preventDefault @onclick='() => ExecuteAsync("hiliteColor", "transparent")'>&#8856;</button>
        </span>

        <span class="rte-group">
            <button type="button" class="btn icon small" title="Bulleted list" @onmousedown:preventDefault @onclick='() => ExecuteAsync("insertUnorderedList")'>&#8226;&#8801;</button>
            <button type="button" class="btn icon small" title="Numbered list" @onmousedown:preventDefault @onclick='() => ExecuteAsync("insertOrderedList")'>1.</button>
            <button type="button" class="btn icon small" title="Clear formatting" @onmousedown:preventDefault @onclick='() => ExecuteAsync("removeFormat")'>T<sub>x</sub></button>
        </span>

        <span class="rte-group">
            <select class="input small" title="Insert a code block, or change the language of the block you are in" @ref="_codeSelect" @onchange="OnCodeBlockChosenAsync">
                <option value="">Code block...</option>
                @foreach (var language in CodeLanguages.All)
                {
                    <option value="@language.Id">@language.Label</option>
                }
            </select>
            <button type="button" class="btn icon small" title="Inline code (select text first)" @onmousedown:preventDefault @onclick="InsertInlineCodeAsync">&lt;/&gt;</button>
        </span>

        <span class="rte-group rte-link-insert">
            <button type="button" class="btn small" title="Insert or edit a link (Ctrl+click a link in the editor to open it)" aria-expanded="@(_isLinkPanelOpen ? "true" : "false")" @onmousedown:preventDefault @onclick="ToggleLinkPanelAsync">Link</button>
            @if (_isLinkPanelOpen)
            {
                <div class="rte-link-panel" role="dialog" aria-label="Link" @onkeydown="OnLinkKeyDownAsync">
                    <label class="field">
                        <span>Web address or document path</span>
                        <span class="rte-link-address">
                            <input class="input" @ref="_linkAddressInput" @bind="_linkAddress" @bind:event="oninput" placeholder="https://example.com or C:\Docs\Report.docx" />
                            <button type="button" class="btn small" title="Choose a Word, Excel, PDF or other document" @onclick="BrowseAsync">Browse...</button>
                        </span>
                    </label>

                    @if (!_hasLinkSelection)
                    {
                        <label class="field">
                            <span>Text to show</span>
                            <input class="input" @bind="_linkText" @bind:event="oninput" placeholder="Optional - the address is shown if empty" />
                        </label>
                    }

                    @if (_linkError is not null)
                    {
                        <div class="rte-link-error" role="alert">@_linkError</div>
                    }

                    <div class="rte-link-actions">
                        <button type="button" class="btn small primary" @onclick="ApplyLinkAsync">@(_isEditingLink ? "Update" : "Insert")</button>
                        @if (_isEditingLink)
                        {
                            <button type="button" class="btn small" @onclick="RemoveLinkAsync">Remove link</button>
                        }
                        <button type="button" class="btn small" @onclick="CloseLinkPanel">Cancel</button>
                    </div>
                </div>
            }
        </span>

        <span class="rte-group rte-table-insert">
            <button type="button" class="btn small" title="Insert a table" aria-expanded="@(_isTablePickerOpen ? "true" : "false")" @onmousedown:preventDefault @onclick="ToggleTablePicker">Table</button>
            @if (_isTablePickerOpen)
            {
                <div class="rte-table-picker" @onmouseleave="CloseTablePicker">
                    <div class="rte-table-grid">
                        @foreach (var row in Enumerable.Range(1, PickerRows))
                        {
                            @foreach (var column in Enumerable.Range(1, PickerColumns))
                            {
                                <button type="button"
                                        class="rte-table-square @(row <= _hoverRows && column <= _hoverColumns ? "active" : string.Empty)"
                                        aria-label="@row rows by @column columns"
                                        @onmousedown:preventDefault
                                        @onmouseover="() => Hover(row, column)"
                                        @onclick="() => InsertTableAsync(row, column)"></button>
                            }
                        }
                    </div>
                    <div class="muted rte-table-size">@_hoverRows x @_hoverColumns</div>
                </div>
            }
        </span>

        <span class="rte-group rte-table-tools" title="Table tools (place the cursor in a table)">
            <select class="input small" title="Change the table the cursor is in" @ref="_tableSelect" @onchange="OnTableActionChosenAsync">
                <option value="">Table tools...</option>
                @foreach (var action in TableActions)
                {
                    <option value="@action.Id">@action.Label</option>
                }
            </select>
            <span class="rte-label" title="Cell shading">Cell</span>
            @foreach (var color in HighlightColors)
            {
                <button type="button" class="swatch" style="background:@color" title="Shade cell @color" aria-label="Shade cell @color" @onmousedown:preventDefault @onclick="() => ShadeCellAsync(color)"></button>
            }
            <button type="button" class="btn icon small" title="Remove cell shading" @onmousedown:preventDefault @onclick='() => ShadeCellAsync(string.Empty)'>&#8856;</button>
        </span>
    </div>

    <div class="rte-surface" contenteditable="true" spellcheck="true" @ref="_surface"></div>
</div>

@code {
    private static readonly string[] TextColors = ["#e53935", "#fb8c00", "#43a047", "#1e88e5", "#8e24aa", "#757575"];
    private static readonly string[] HighlightColors = ["#fff176", "#a5d6a7", "#f48fb1", "#81d4fa"];

    private const int PickerRows = 6;
    private const int PickerColumns = 8;

    private static readonly (string Id, string Label)[] TableActions =
    [
        ("addRowAbove", "Add row above"),
        ("addRowBelow", "Add row below"),
        ("addColumnLeft", "Add column left"),
        ("addColumnRight", "Add column right"),
        ("deleteRow", "Delete row"),
        ("deleteColumn", "Delete column"),
        ("toggleHeader", "Toggle header row"),
        ("deleteTable", "Delete table")
    ];

    private ElementReference _surface;
    private ElementReference _codeSelect;
    private ElementReference _tableSelect;
    private ElementReference _linkAddressInput;
    private bool _isLinkPanelOpen;
    private bool _isEditingLink;
    private bool _hasLinkSelection;
    private bool _focusLinkAddress;
    private string _linkAddress = string.Empty;
    private string _linkText = string.Empty;
    private string? _linkError;
    private bool _isTablePickerOpen;
    private int _hoverRows = 3;
    private int _hoverColumns = 3;

    [Parameter]
    public string InitialHtml { get; set; } = string.Empty;

    [Parameter]
    public bool AutoFocus { get; set; } = true;

    public async Task<string> GetHtmlAsync()
    {
        return await Js.InvokeAsync<string>("journalInterop.rte.getHtml", _surface);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("journalInterop.rte.init", _surface, InitialHtml, AutoFocus);
        }

        if (_focusLinkAddress)
        {
            _focusLinkAddress = false;
            await _linkAddressInput.FocusAsync();
        }
    }

    private async Task ToggleLinkPanelAsync()
    {
        if (_isLinkPanelOpen)
        {
            CloseLinkPanel();
            return;
        }

        var context = await Js.InvokeAsync<LinkContext>("journalInterop.rte.getLinkContext", _surface);
        _isEditingLink = context.IsExisting;
        _hasLinkSelection = !context.IsExisting && context.Text.Length > 0;
        _linkAddress = context.Href;
        _linkText = context.IsExisting ? string.Empty : context.Text;
        _linkError = null;
        _isLinkPanelOpen = true;
        _focusLinkAddress = true;
    }

    private void CloseLinkPanel() => _isLinkPanelOpen = false;

    private async Task BrowseAsync()
    {
        var path = Links.BrowseForDocument();
        if (path is not null)
        {
            _linkAddress = path;
            _linkError = null;
        }

        await _linkAddressInput.FocusAsync();
    }

    private async Task ApplyLinkAsync()
    {
        try
        {
            var href = LinkAddress.ToHref(_linkAddress);
            await Js.InvokeVoidAsync("journalInterop.rte.applyLink", _surface, href, _linkText.Trim());
            _isLinkPanelOpen = false;
        }
        catch (JournalException exception)
        {
            _linkError = exception.Message;
        }
    }

    private async Task RemoveLinkAsync()
    {
        _isLinkPanelOpen = false;
        await ExecuteAsync("unlink");
    }

    private async Task OnLinkKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyLinkAsync();
        }
        else if (e.Key == "Escape")
        {
            CloseLinkPanel();
        }
    }

    private sealed record LinkContext(string Href, string Text, bool IsExisting);

    private async Task ExecuteAsync(string command, object? value = null)
    {
        await Js.InvokeVoidAsync("journalInterop.rte.exec", _surface, command, value);
    }

    private async Task OnCodeBlockChosenAsync(ChangeEventArgs e)
    {
        var language = e.Value?.ToString();
        if (string.IsNullOrEmpty(language))
        {
            return;
        }

        await Js.InvokeVoidAsync("journalInterop.rte.insertCodeBlock", _surface, language);
        await Js.InvokeVoidAsync("journalInterop.rte.resetSelect", _codeSelect);
    }

    private async Task InsertInlineCodeAsync()
    {
        await Js.InvokeVoidAsync("journalInterop.rte.insertInlineCode", _surface);
    }

    private void ToggleTablePicker() => _isTablePickerOpen = !_isTablePickerOpen;

    private void CloseTablePicker() => _isTablePickerOpen = false;

    private void Hover(int rows, int columns)
    {
        _hoverRows = rows;
        _hoverColumns = columns;
    }

    private async Task InsertTableAsync(int rows, int columns)
    {
        _isTablePickerOpen = false;
        await Js.InvokeVoidAsync("journalInterop.table.insert", _surface, rows, columns);
    }

    private async Task OnTableActionChosenAsync(ChangeEventArgs e)
    {
        var action = e.Value?.ToString();
        if (string.IsNullOrEmpty(action))
        {
            return;
        }

        await Js.InvokeVoidAsync("journalInterop.table.exec", _surface, action, null);
        await Js.InvokeVoidAsync("journalInterop.rte.resetSelect", _tableSelect);
    }

    private Task ShadeCellAsync(string color)
    {
        return Js.InvokeVoidAsync("journalInterop.table.exec", _surface, "shade", color).AsTask();
    }

    private Task OnBlockChangedAsync(ChangeEventArgs e)
    {
        return ExecuteAsync("formatBlock", e.Value);
    }
}
