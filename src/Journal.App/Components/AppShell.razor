@implements IDisposable
@inject ThemeService Theme
@inject ILinkService Links
@inject IJSRuntime Js

<DynamicComponent Type="PageType" Parameters="PageParameters" />

@code {
    private DotNetObjectReference<AppShell>? _selfReference;

    [Parameter, EditorRequired]
    public Type PageType { get; set; } = default!;

    [Parameter]
    public IDictionary<string, object?>? PageParameters { get; set; }

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyThemeAsync();
            _selfReference = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("journalInterop.links.attach", _selfReference);
        }
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        _selfReference?.Dispose();
    }

    [JSInvokable]
    public void OpenLink(string href)
    {
        Links.Open(href);
    }

    private void OnThemeChanged()
    {
        _ = InvokeAsync(ApplyThemeAsync);
    }

    private async Task ApplyThemeAsync()
    {
        await Js.InvokeVoidAsync("journalInterop.setTheme", Theme.IsDark);
    }
}
