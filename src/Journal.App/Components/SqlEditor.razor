@inject IJSRuntime Js

<div class="sql-editor">
    <pre class="sql-highlight" @ref="_highlight" aria-hidden="true"><code>@((MarkupString)SqlHighlighter.ToHtml(_text + "\n"))</code></pre>
    <textarea class="sql-input"
              @ref="_input"
              @bind="_text"
              @bind:event="oninput"
              wrap="off"
              spellcheck="false"
              aria-label="SQL"></textarea>
</div>

@code {
    private ElementReference _highlight;
    private ElementReference _input;
    private string _text = string.Empty;

    [Parameter]
    public string InitialText { get; set; } = string.Empty;

    [Parameter]
    public bool AutoFocus { get; set; } = true;

    public string GetContent() => _text;

    protected override void OnInitialized()
    {
        _text = InitialText;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("journalInterop.sql.attach", _input, _highlight);
            if (AutoFocus)
            {
                await _input.FocusAsync();
            }
        }
    }
}
