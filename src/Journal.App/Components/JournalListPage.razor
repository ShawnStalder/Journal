@inherits SafeComponentBase
@inject IJournalCatalog Catalog

<div class="dialog-page list-page">
    <h1>@(ShowArchived ? "Open Archived Journal" : "Open Journal")</h1>
    <p class="muted"><span class="path">@(ShowArchived ? Catalog.ArchivePath : Catalog.RootPath)</span></p>

    <input class="input" placeholder="Filter journals..." @ref="_filterInput" @bind="_filter" @bind:event="oninput" />

    <ErrorBanner Message="@ErrorMessage" OnDismiss="ClearError" />

    <ul class="journal-list">
        @foreach (var name in FilteredNames)
        {
            <li @key="name">
                <button type="button" class="list-item" @onclick="() => OnJournalChosen(name)">@name</button>
            </li>
        }
    </ul>

    @if (_isLoaded && !FilteredNames.Any())
    {
        <p class="muted empty">@EmptyMessage</p>
    }

    <div class="actions">
        <button type="button" class="btn" @onclick="LoadAsync">Refresh</button>
    </div>
</div>

@code {
    private ElementReference _filterInput;
    private IReadOnlyList<string> _names = [];
    private string _filter = string.Empty;
    private bool _isLoaded;

    [Parameter, EditorRequired]
    public Action<string> OnJournalChosen { get; set; } = default!;

    [Parameter]
    public bool ShowArchived { get; set; }

    private string EmptyMessage
    {
        get
        {
            if (_names.Count > 0)
            {
                return "No journals match the filter.";
            }

            return ShowArchived
                ? "No archived journals. Use the archive button inside a journal to archive it."
                : "No journals yet. Use New Journal from the tray menu.";
        }
    }

    private IEnumerable<string> FilteredNames => _names
        .Where(name => name.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _filterInput.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        await RunSafelyAsync(async () => _names = await Task.Run(() => ShowArchived ? Catalog.GetArchivedJournalNames() : Catalog.GetJournalNames()));
        _isLoaded = true;
    }
}
