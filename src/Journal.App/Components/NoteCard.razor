@inject NoteHtmlSanitizer Sanitizer
@inject IJSRuntime Js

<article class="note @(Note.Type == NoteType.Sql ? "note-sql" : "note-text") @(IsCollapsed ? "collapsed" : string.Empty)">
    <header class="note-header">
        <button type="button"
                class="btn icon small collapse-toggle @(IsCollapsed ? "is-collapsed" : string.Empty)"
                title="@(IsCollapsed ? "Expand note" : "Collapse note")"
                aria-label="@(IsCollapsed ? "Expand note" : "Collapse note")"
                aria-expanded="@(!IsCollapsed)"
                @onclick="() => OnToggleCollapse.InvokeAsync(Note)">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
            </svg>
        </button>
        <span class="badge">@(Note.Type == NoteType.Sql ? "SQL" : "Text")</span>
        <h4 class="note-title" @onclick="() => OnToggleCollapse.InvokeAsync(Note)">@Note.Title</h4>
        <time class="muted">@Note.CreatedOn.ToString("h:mm tt")</time>
        @if (ShowModified)
        {
            <span class="muted modified-stamp" title="Last modified">edited @Note.ModifiedOn.ToString("MMM d, h:mm tt")</span>
        }
        <span class="spacer"></span>

        @if (Note.Type == NoteType.Sql)
        {
            <button type="button" class="btn small" @onclick="CopyAsync">@(_justCopied ? "Copied" : "Copy")</button>
        }

        <button type="button" class="btn small" @onclick="() => OnEdit.InvokeAsync(Note)">Edit</button>

        @if (_isConfirmingDelete)
        {
            <button type="button" class="btn small danger" @onclick="ConfirmDeleteAsync">Delete</button>
            <button type="button" class="btn small" @onclick="() => _isConfirmingDelete = false">Keep</button>
        }
        else
        {
            <button type="button" class="btn small" @onclick="() => _isConfirmingDelete = true">Delete</button>
        }
    </header>

    @if (!IsCollapsed)
    {
        @if (Note.Type == NoteType.Sql)
        {
            <pre class="sql-view"><code>@((MarkupString)_renderedContent)</code></pre>
        }
        else
        {
            <div class="note-body" @ref="_body">@((MarkupString)_renderedContent)</div>
        }
    }
</article>

@code {
    private JournalNote? _renderedNote;
    private string _renderedContent = string.Empty;
    private ElementReference _body;
    private bool _isConfirmingDelete;
    private bool _justCopied;

    [Parameter, EditorRequired]
    public JournalNote Note { get; set; } = default!;

    [Parameter]
    public bool ShowModified { get; set; }

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback<JournalNote> OnToggleCollapse { get; set; }

    [Parameter]
    public EventCallback<JournalNote> OnEdit { get; set; }

    [Parameter]
    public EventCallback<JournalNote> OnDelete { get; set; }

    protected override void OnParametersSet()
    {
        if (_renderedNote == Note)
        {
            return;
        }

        _renderedNote = Note;
        _renderedContent = Note.Type == NoteType.Sql
            ? SqlHighlighter.ToHtml(Note.Content)
            : Sanitizer.Sanitize(Note.Content);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Note.Type == NoteType.Text && !IsCollapsed)
        {
            await Js.InvokeVoidAsync("journalInterop.code.highlight", _body);
        }
    }

    private async Task CopyAsync()
    {
        await Js.InvokeVoidAsync("journalInterop.copyText", Note.Content);
        _justCopied = true;
        StateHasChanged();

        await Task.Delay(1500);
        _justCopied = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        _isConfirmingDelete = false;
        await OnDelete.InvokeAsync(Note);
    }
}
